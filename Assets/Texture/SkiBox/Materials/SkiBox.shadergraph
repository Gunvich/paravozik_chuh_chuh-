{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "1b4f33f74b684324a563c3af1cdf20c5",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SunMoon (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 584.0,
            "y": -599.2000732421875,
            "width": 209.59991455078125,
            "height": 213.60003662109375
        }
    },
    "m_Slots": [
        {
            "m_Id": "2e09fc26857a46a1b751da99a02e99c9"
        },
        {
            "m_Id": "c6b470ccc6244699bce053d736168ff8"
        },
        {
            "m_Id": "d0c3feca0040416ca9e71b2031e62728"
        },
        {
            "m_Id": "d7ad07a56f66405382c8c04f46b57360"
        },
        {
            "m_Id": "c26df70921044ce0903fff3b14ebcbe8"
        },
        {
            "m_Id": "f6fd110c257a4934964884ec09cd7e2d"
        },
        {
            "m_Id": "fb80e78b06fa4248adc9f3d993b217d0"
        },
        {
            "m_Id": "2868523f5132478e8fd589ff0e16d029"
        },
        {
            "m_Id": "0b10e13d7d424713bf6ecf91105e9d76"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SunMoon",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float vLen = length(ViewDir);\r\nfloat3 v = vLen > 1e-5 ? (ViewDir / vLen) : float3(0.0, 1.0, 0.0);\r\n\r\nfloat bLen = length(BodyDir);\r\nfloat3 d = bLen > 1e-5 ? (BodyDir / bLen) : float3(0.0, 1.0, 0.0);\r\n\r\n// Локальні осі правого/верхнього напрямку відносно світила\r\nfloat3 worldUp = abs(d.y) > 0.999 ? float3(0.0, 0.0, 1.0) : float3(0.0, 1.0, 0.0);\r\nfloat3 right = normalize(cross(worldUp, d));\r\nfloat3 up = cross(d, right);\r\n\r\n// Проєкція погляду на площину текстури\r\nfloat facing = dot(v, d);\r\nfloat2 offset = float2(dot(v, right), dot(v, up));\r\n\r\n// Поворот текстури на заданий кут\r\nfloat rad = radians(Rotation);\r\nfloat s, c;\r\nsincos(rad, s, c);\r\noffset = float2(offset.x * c - offset.y * s, offset.x * s + offset.y * c);\r\n\r\n// Масштабування в діапазон UV [0..1]\r\nUV = (offset / max(Size, 1e-4)) * 0.5 + 0.5;\r\n\r\n// Маска: тільки передня півсфера, тільки в межах [0..1] і вище лінії горизонту\r\nfloat2 inBounds = step(0.0, UV) * step(UV, 1.0);\r\nfloat aboveHorizon = smoothstep(-0.04, 0.04, v.y);\r\nMask = inBounds.x * inBounds.y * step(0.0, facing) * aboveHorizon;\r\n\r\n// Процедурний ореол навколо\r\nHalo = pow(max(saturate(facing), 1e-5), max(HaloPower, 1.0)) * HaloIntensity * aboveHorizon;"
}

